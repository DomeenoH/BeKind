---
import { Search, X } from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CategorySection from '../components/CategorySection.astro';
import CharacterAvatar from '../components/CharacterAvatar.astro';
import { orderedLaws } from '../data/laws';
import { categories } from '../data/law-types';
import type { CharacterId } from '../data/characters';
import { cast, howToUse, site } from '../data/site';

const grouped = categories.map((category) => ({
  category,
  laws: orderedLaws.filter((law) => law.category === category.id),
}));

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    alternateName: site.title,
    url: new URL('/', Astro.site ?? Astro.url.origin).href,
    description: site.description,
    inLanguage: 'zh-CN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: '互联网沟通法则',
    numberOfItems: orderedLaws.length,
    itemListElement: orderedLaws.map((law, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: law.title,
      url: new URL(`/${law.slug}/`, Astro.site ?? Astro.url.origin).href,
    })),
  },
];
---

<BaseLayout description={site.description} jsonLd={jsonLd} bodyClass="home-body">
  <div class="shell">
    <section class="home-intro">
      <div class="home-intro-grid">
        <div>
          <p class="eyebrow">{site.eyebrow}</p>
          <h1 class="display">{site.title}</h1>
          <p class="home-lead">{site.tagline}</p>
          <p class="home-desc">{site.intro}</p>

          <div class="search" data-search-box role="search">
            <label class="sr-only" for="law-search">搜索法则</label>
            <Search size={18} stroke-width={1.75} aria-hidden="true" />
            <input
              id="law-search"
              type="search"
              placeholder={site.searchPlaceholder}
              autocomplete="off"
              spellcheck="false"
              data-law-search
            />
            <kbd class="search-hint" aria-hidden="true">/</kbd>
            <button class="search-clear" type="button" data-search-clear aria-label="清空搜索">
              <X size={14} stroke-width={2} aria-hidden="true" />
            </button>
          </div>

          <div class="search-status">
            <span class="search-status-hint" data-search-hint>按 <kbd>/</kbd> 聚焦搜索，Esc 清空</span>
            <span data-result-count></span>
            <button class="search-reset" type="button" data-search-reset hidden>清除筛选</button>
            <span class="sr-only" data-result-live aria-live="polite"></span>
          </div>
        </div>

        <aside class="contents" aria-label="目录">
          <p class="contents-label">目录</p>
          <div class="contents-list">
            {grouped.map(({ category, laws }) => (
              <a href={`#${category.id}`}>
                <span class="contents-num" aria-hidden="true">{category.eyebrow}</span>
                <span class="contents-name">{category.title}</span>
                <span class="contents-count">{laws.length}</span>
              </a>
            ))}
          </div>
        </aside>
      </div>
    </section>

    <div class="laws" id="laws">
      {grouped.map(({ category, laws }) => <CategorySection category={category} laws={laws} />)}
    </div>

    <section class="search-empty" data-empty-results hidden aria-live="polite">
      <h2>{site.searchEmptyTitle}</h2>
      <p>{site.searchEmptyHint}</p>
    </section>
  </div>

  <section class="about" id="about">
    <div class="shell">
      <div class="about-grid">
        <div>
          <h2 class="about-title">这是什么</h2>
          <p class="about-text">
            一份讲怎么在网上好好说话的手册。{orderedLaws.length} 条法则，一半来自 nohello.net、xyproblem.info
            这类老帖，一半来自我们把自己天聊死之后的复盘。
          </p>
          <p class="about-text">
            多数配一段 QQ 群聊：先演示怎么把一件小事拖成事故，再给一个能照着念的说法。没有大道理，不搞心态，也不要求你变得热情开朗。
          </p>
          <p class="about-note">
            场景由多米诺、西打、尾巴和群友出演。头像是他们的 QQ 头像，实时拉取，不存本地。
          </p>
        </div>

        <ul class="cast-list">
          {cast.map((person) => (
            <li class="cast-item">
              <CharacterAvatar character={person.id as CharacterId} size={32} />
              <div class="cast-copy">
                <p class="cast-name">{person.name}</p>
                <p class="cast-role">{person.role}</p>
                <p class="cast-line">{person.line}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="steps">
        {howToUse.map((step) => (
          <div class="step">
            <p class="step-num">{step.step}</p>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    const input = document.querySelector('[data-law-search]');
    const box = document.querySelector('[data-search-box]');
    const cards = [...document.querySelectorAll('[data-law-card]')];
    const sections = [...document.querySelectorAll('[data-law-section]')];
    const countEl = document.querySelector('[data-result-count]');
    const liveEl = document.querySelector('[data-result-live]');
    const hintEl = document.querySelector('[data-search-hint]');
    const resetEl = document.querySelector('[data-search-reset]');
    const clearEl = document.querySelector('[data-search-clear]');
    const emptyEl = document.querySelector('[data-empty-results]');
    const statusEl = document.querySelector('.search-status');

    function applyFilters() {
      const raw = input.value;
      const query = raw.trim().toLocaleLowerCase('zh-CN');
      let visible = 0;

      cards.forEach((card) => {
        const match = !query || (card.dataset.search || '').includes(query);
        card.hidden = !match;
        if (match) visible += 1;
      });

      sections.forEach((section) => {
        const own = [...section.querySelectorAll('[data-law-card]')];
        const shown = own.filter((card) => !card.hidden).length;
        section.hidden = shown === 0;
        const counter = section.querySelector('[data-section-count]');
        if (counter) counter.textContent = query ? shown + ' 条' : own.length + ' 条';
      });

      if (query) {
        countEl.textContent = '找到 ' + visible + ' 条';
        if (liveEl) liveEl.textContent = '找到 ' + visible + ' 条法则';
        resetEl.hidden = false;
        emptyEl.hidden = visible !== 0;
      } else {
        countEl.textContent = '';
        if (liveEl) liveEl.textContent = '';
        resetEl.hidden = true;
        emptyEl.hidden = true;
      }

      if (hintEl) hintEl.hidden = Boolean(query);
      if (statusEl) statusEl.classList.toggle('is-active', Boolean(query));
      box.classList.toggle('has-value', raw.length > 0);
    }

    function clearSearch() {
      input.value = '';
      applyFilters();
      input.focus();
    }

    input.addEventListener('input', applyFilters);
    clearEl.addEventListener('click', clearSearch);
    resetEl.addEventListener('click', clearSearch);

    document.addEventListener('keydown', (event) => {
      const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement?.tagName || '');
      if (event.key === '/' && !typing) {
        event.preventDefault();
        input.focus();
        return;
      }
      if (event.key === 'Escape' && document.activeElement === input) {
        clearSearch();
        input.blur();
      }
    });

    applyFilters();
  </script>
</BaseLayout>
