---
import { Search, X } from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CategorySection from '../components/CategorySection.astro';
import CharacterAvatar from '../components/CharacterAvatar.astro';
import { orderedLaws } from '../data/laws';
import { categories, situations } from '../data/law-types';
import { buildSearchDocs } from '../lib/law-search';
import type { CharacterId } from '../data/characters';
import { cast, howToUse, site } from '../data/site';

const grouped = categories.map((category) => ({
  category,
  laws: orderedLaws.filter((law) => law.category === category.id),
}));

// 检索字段在建站时算好，页面里只留一份 JSON。
// 别在每张卡片上再塞一份 data-search：同一段文本存两遍，首页体积翻倍。
const searchIndexJson = JSON.stringify(buildSearchDocs(orderedLaws)).replace(/</g, '\\u003c');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    alternateName: site.title,
    url: new URL('/', Astro.site ?? Astro.url.origin).href,
    description: site.description,
    inLanguage: 'zh-CN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: '互联网沟通法则',
    numberOfItems: orderedLaws.length,
    itemListElement: orderedLaws.map((law, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: law.title,
      url: new URL(`/${law.slug}/`, Astro.site ?? Astro.url.origin).href,
    })),
  },
];
---

<BaseLayout description={site.description} jsonLd={jsonLd} bodyClass="home-body">
  <div class="shell">
    <section class="home-intro">
      <div class="home-intro-inner">
        <div>
          <p class="eyebrow">{site.eyebrow}</p>
          <h1 class="display">{site.title}</h1>
          <p class="home-lead">{site.tagline}</p>
          <p class="home-desc">{site.intro}</p>

          <div class="search" data-search-box role="search">
            <label class="sr-only" for="law-search">搜索法则</label>
            <Search size={18} stroke-width={1.75} aria-hidden="true" />
            <input
              id="law-search"
              type="search"
              placeholder={site.searchPlaceholder}
              autocomplete="off"
              spellcheck="false"
              data-law-search
            />
            <kbd class="search-hint" aria-hidden="true">/</kbd>
            <button class="search-clear" type="button" data-search-clear aria-label="清空搜索">
              <X size={14} stroke-width={2} aria-hidden="true" />
            </button>
          </div>

          <div class="filter-row">
            <div class="situation-filter" role="group" aria-label="按场合筛选">
              {
                situations.map((situation) => (
                  <button class="situation-chip" type="button" data-situation={situation.id} aria-pressed="false">
                    {situation.label}
                  </button>
                ))
              }
            </div>

            <div class="search-status">
              <span data-result-count></span>
              <button class="search-reset" type="button" data-search-reset hidden>清除筛选</button>
              <span class="sr-only" data-result-live aria-live="polite"></span>
            </div>
          </div>
        </div>

      </div>
    </section>

    <div class="laws" id="laws">
      {grouped.map(({ category, laws }) => <CategorySection category={category} laws={laws} />)}
    </div>

    <section class="search-empty" data-empty-results hidden aria-live="polite">
      <h2>{site.searchEmptyTitle}</h2>
      <p>{site.searchEmptyHint}</p>
    </section>
  </div>

  <section class="about" id="about">
    <div class="shell">
      <div class="about-grid">
        <div>
          <h2 class="about-title">这是什么</h2>
          <p class="about-text">
            这些法则一半来自 nohello.net、xyproblem.info 这类老帖，
            一半来自我们把自己天聊死之后的复盘。
          </p>
          <p class="about-text">
            不要求你变得热情开朗。
          </p>
        </div>

        <ul class="cast-list">
          {cast.map((person) => (
            <li class="cast-item">
              <CharacterAvatar character={person.id as CharacterId} size={32} />
              <div class="cast-copy">
                <p class="cast-name">{person.name}</p>
                {'href' in person ? (
                  <a class="cast-role cast-role-link" href={person.href} target="_blank" rel="noreferrer">
                    {person.role} ↗
                  </a>
                ) : (
                  <p class="cast-role">{person.role}</p>
                )}
                <p class="cast-line">{person.line}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="steps">
        {howToUse.map((step) => (
          <div class="step">
            <p class="step-num">{step.step}</p>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script is:inline type="application/json" id="law-search-index" set:html={searchIndexJson} />

  <script>
    import { orderQuery, searchLawsRelaxed } from '../lib/law-search';

    const indexEl = document.getElementById('law-search-index');
    const docs = JSON.parse(indexEl?.textContent || '[]');

    const input = document.querySelector('[data-law-search]');
    const box = document.querySelector('[data-search-box]');
    const cards = [...document.querySelectorAll('[data-law-card]')];
    const sections = [...document.querySelectorAll('[data-law-section]')];
    const countEl = document.querySelector('[data-result-count]');
    const liveEl = document.querySelector('[data-result-live]');
    const resetEl = document.querySelector('[data-search-reset]');
    const clearEl = document.querySelector('[data-search-clear]');
    const emptyEl = document.querySelector('[data-empty-results]');
    const statusEl = document.querySelector('.search-status');
    const chips = [...document.querySelectorAll('[data-situation]')];
    const lawsEl = document.getElementById('laws');

    // 最近一次结果，Enter 用它跳转
    let latest = [];

    // 场合是「往里收」的单选：点一个看这个场合，再点一次还原。
    let activeSituation = null;

    function writeUrl(query) {
      const url = new URL(location.href);
      if (query) url.searchParams.set('q', query);
      else url.searchParams.delete('q');
      if (activeSituation) url.searchParams.set('s', activeSituation);
      else url.searchParams.delete('s');
      // 换搜索要清掉旧锚点，否则刷新后锚点会把筛选条件顶回去
      if (url.hash.startsWith('#law-')) url.hash = '';
      history.replaceState(null, '', url);
    }

    function applyFilters(options = {}) {
      const raw = input.value;
      const query = raw.trim();
      const filtering = Boolean(query || activeSituation);
      latest = query ? searchLawsRelaxed(docs, query) : [];

      const rank = new Map(latest.map((item, index) => [item.doc.slug, index]));

      cards.forEach((card) => {
        const position = rank.get(card.dataset.slug);
        const matchQuery = !query || position !== undefined;
        const matchSituation =
          !activeSituation || (card.dataset.situations || '').split(' ').includes(activeSituation);
        const match = matchQuery && matchSituation;
        card.hidden = !match;
        // 组内按相关度排；清空时把 order 交还给 DOM 顺序
        card.style.order = query && position !== undefined ? String(position) : '';
      });

      let visible = 0;
      sections.forEach((section) => {
        const own = [...section.querySelectorAll('[data-law-card]')];
        const shown = own.filter((card) => !card.hidden).length;
        visible += shown;
        section.hidden = filtering ? shown === 0 : false;
        const counter = section.querySelector('[data-section-count]');
        if (counter) counter.textContent = filtering ? shown + ' 条' : own.length + ' 条';
      });

      if (filtering) {
        const number = query ? orderQuery(query) : undefined;
        const label =
          visible === 1 && number !== undefined
            ? `第 ${number} 条 · 按 Enter 打开`
            : `找到 ${visible} 条`;
        countEl.textContent = label;
        if (liveEl) liveEl.textContent = `找到 ${visible} 条法则`;
        resetEl.hidden = false;
        emptyEl.hidden = visible !== 0;
      } else {
        countEl.textContent = '';
        if (liveEl) liveEl.textContent = '';
        resetEl.hidden = true;
        emptyEl.hidden = true;
      }

      chips.forEach((chip) => {
        const on = chip.dataset.situation === activeSituation;
        chip.setAttribute('aria-pressed', on ? 'true' : 'false');
        chip.classList.toggle('is-active', on);
      });

      if (statusEl) statusEl.classList.toggle('is-active', filtering);
      box.classList.toggle('has-value', raw.length > 0);

      if (!options.silent) writeUrl(query);
    }

    function clearFilters() {
      input.value = '';
      activeSituation = null;
      applyFilters();
      input.focus();
    }

    let typing = 0;
    input.addEventListener('input', () => {
      applyFilters({ silent: true });
      window.clearTimeout(typing);
      // 每敲一个字都改 URL 会把历史记录刷烂，也拖慢输入
      typing = window.setTimeout(() => writeUrl(input.value.trim()), 200);
    });

    input.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter') return;
      const first = latest[0];
      if (!first) return;
      event.preventDefault();
      location.href = `/${first.doc.slug}/`;
    });

    clearEl.addEventListener('click', clearFilters);
    resetEl.addEventListener('click', clearFilters);

    chips.forEach((chip) => {
      chip.addEventListener('click', () => {
        const id = chip.dataset.situation;
        activeSituation = activeSituation === id ? null : id;
        applyFilters();
        // 筛选起作用的地方在下面，人在顶部时看不到任何变化，滚过去
        if (activeSituation && lawsEl && lawsEl.getBoundingClientRect().top > window.innerHeight * 0.6) {
          lawsEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });

    document.addEventListener('keydown', (event) => {
      const inField = /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement?.tagName || '');
      if (event.key === '/' && !inField) {
        event.preventDefault();
        input.focus();
        return;
      }
      if (event.key === 'Escape' && document.activeElement === input) {
        clearFilters();
        input.blur();
      }
    });

    // 分享出去的 ?q= / ?s= 要能还原，刷新也不丢
    const params = new URL(location.href).searchParams;
    const initialQuery = params.get('q') || '';
    const initialSituation = params.get('s') || '';
    if (initialQuery) input.value = initialQuery;
    if (chips.some((chip) => chip.dataset.situation === initialSituation)) {
      activeSituation = initialSituation;
    }
    applyFilters({ silent: !initialQuery && !activeSituation });
  </script>
</BaseLayout>
