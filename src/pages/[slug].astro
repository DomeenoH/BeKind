---
import { ArrowLeft, ArrowRight, ChevronLeft, ChevronRight, Home } from 'lucide-astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ChatScene from '../components/ChatScene.astro';
import HeroEffect from '../components/HeroEffect.astro';
import LawVisual from '../components/LawVisual.astro';
import ShareActions from '../components/ShareActions.astro';
import { orderedLaws } from '../data/laws';
import { relatedLaws } from '../data/related';
import { lawReferences } from '../data/references';
import { categories } from '../data/law-types';
import { site } from '../data/site';
import type { Law } from '../data/law-types';

export function getStaticPaths() {
  return orderedLaws.map((law) => ({ params: { slug: law.slug }, props: { law } }));
}

interface Props {
  law: Law;
}

const { law } = Astro.props;
const index = orderedLaws.findIndex((item) => item.slug === law.slug);
const previous = orderedLaws[index - 1];
const next = orderedLaws[index + 1];
const category = categories.find((item) => item.id === law.category);
const canonicalUrl = new URL(`/${law.slug}/`, Astro.site ?? Astro.url.origin).href;

const related = (relatedLaws[law.slug] ?? [])
  .map((slug) => orderedLaws.find((item) => item.slug === slug))
  .filter((item): item is Law => Boolean(item));
const references = lawReferences[law.slug] ?? [];
const footerHtml = law.footerHtml.replaceAll('{{YEAR}}', String(site.year));

// 副标题若只是英文名的另一种写法（惠顿定律那种），就不再重复显示一次。
const subtitleText = law.hero.subtitleHtml.replace(/<[^>]+>/g, '').trim();
const showSubtitle =
  Boolean(subtitleText) && subtitleText.toLowerCase() !== law.englishTitle.toLowerCase();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: law.title,
    alternativeHeadline: law.englishTitle,
    description: law.summary,
    inLanguage: 'zh-CN',
    url: canonicalUrl,
    mainEntityOfPage: canonicalUrl,
    author: { '@type': 'Person', name: '多米诺' },
    publisher: { '@type': 'Organization', name: site.name },
    isPartOf: {
      '@type': 'WebSite',
      name: site.name,
      url: new URL('/', Astro.site ?? Astro.url.origin).href,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: site.title,
        item: new URL('/', Astro.site ?? Astro.url.origin).href,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: category?.title ?? '主题',
        item: new URL(`/#${law.category}`, Astro.site ?? Astro.url.origin).href,
      },
      { '@type': 'ListItem', position: 3, name: law.title, item: canonicalUrl },
    ],
  },
];
---

<BaseLayout
  title={`${law.title} · ${site.name}`}
  description={law.summary}
  canonicalPath={`/${law.slug}/`}
  ogType="article"
  footer="minimal"
  jsonLd={jsonLd}
>
  <div class="read-progress" aria-hidden="true"><span data-read-progress></span></div>

  <div class="shell">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="/"><Home size={13} stroke-width={1.75} aria-hidden="true" />首页</a>
      <span class="sep" aria-hidden="true">/</span>
      <a href={`/#${law.category}`}>{category?.title ?? '全部法则'}</a>
    </nav>

    <header class="law-hero">
      <div class="law-hero-grid">
        <div>
          <p class="eyebrow">{law.englishTitle}</p>
          <h1 class="law-title" set:html={law.hero.titleHtml} />
          {showSubtitle && <span class="law-sub" set:html={law.hero.subtitleHtml} />}

          {law.layout === 'statement' ? (
            <div class="statement-impact" set:html={law.hero.leadHtml} />
          ) : (
            law.hero.leadHtml && <div class="law-lead" set:html={law.hero.leadHtml} />
          )}

          {law.hero.effect && <HeroEffect name={law.hero.effect} />}
        </div>

        <div class="hero-aside">
          <span class="hero-index">{String(law.order).padStart(2, '0')} / {orderedLaws.length}</span>
        </div>
      </div>

      <ShareActions law={law} />
    </header>
  </div>

  {law.layout === 'comparison' && law.bad && law.good ? (
    <div class="scenes">
      <ChatScene scene={law.bad} variant="bad" />
      {law.visual && <LawVisual name={law.visual} />}
      <ChatScene scene={law.good} variant="good" />
    </div>
  ) : (
    <section class="statement">
      <div class="shell">
        <div class="statement-card" set:html={law.specialHtml ?? ''} />
      </div>
    </section>
  )}

  <div class="shell">
    <nav class="pager" aria-label="上下条">
      {previous ? (
        <a class="pager-item prev" href={`/${previous.slug}/`}>
          <span class="pager-label"><ChevronLeft size={13} stroke-width={2} aria-hidden="true" />上一条</span>
          <span class="pager-title">{previous.title}</span>
        </a>
      ) : (
        <a class="pager-item prev" href="/#laws">
          <span class="pager-label"><ArrowLeft size={13} stroke-width={2} aria-hidden="true" />回到目录</span>
          <span class="pager-title">全部法则</span>
        </a>
      )}

      {next ? (
        <a class="pager-item next" href={`/${next.slug}/`}>
          <span class="pager-label">下一条<ChevronRight size={13} stroke-width={2} aria-hidden="true" /></span>
          <span class="pager-title">{next.title}</span>
        </a>
      ) : (
        <a class="pager-item next" href="/#laws">
          <span class="pager-label">读完了<ArrowRight size={13} stroke-width={2} aria-hidden="true" /></span>
          <span class="pager-title">回到目录</span>
        </a>
      )}
    </nav>

    {related.length > 0 && (
      <nav class="related" aria-label="相关条目">
        <p class="related-label">相关</p>
        <ul class="related-list">
          {related.map((item) => (
            <li>
              <a href={`/${item.slug}/`}>
                <span>{item.title}</span>
                <span class="related-en">{item.englishTitle}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    {references.length > 0 && (
      <section class="references" aria-label="参考来源">
        <p class="references-label">参考</p>
        <ul>
          {references.map((reference) => (
            <li>
              <a href={reference.url} target="_blank" rel="noreferrer">{reference.label}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <footer class="law-footer" set:html={footerHtml} />
  </div>

  <script is:inline>
    const progress = document.querySelector('[data-read-progress]');

    function updateProgress() {
      if (!progress) return;
      const doc = document.documentElement;
      const max = doc.scrollHeight - doc.clientHeight;
      const ratio = max > 0 ? Math.min(1, Math.max(0, doc.scrollTop / max)) : 0;
      progress.style.width = (ratio * 100).toFixed(2) + '%';
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress);
    updateProgress();
  </script>


</BaseLayout>
