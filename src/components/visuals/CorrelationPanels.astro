---
const arrow = (x1: number, y1: number, x2: number, y2: number) => {
  const length = Math.hypot(x2 - x1, y2 - y1);
  const ux = (x2 - x1) / length;
  const uy = (y2 - y1) / length;
  return {
    shaft: `M${x1} ${y1} L${x2} ${y2}`,
    tip: `M${x2 - 6 * ux + 3 * uy} ${y2 - 6 * uy - 3 * ux} L${x2} ${y2} L${x2 - 6 * ux - 3 * uy} ${y2 - 6 * uy + 3 * ux}`,
  };
};

const panels = [
  { x: 4, title: 'X 导致 Y', arrows: [arrow(48, 76, 70, 76)] },
  { x: 128, title: 'Y 导致 X', arrows: [arrow(196, 76, 176, 76)] },
  {
    x: 252,
    title: 'Z 同时导致两者',
    arrows: [arrow(300, 44, 286, 64), arrow(314, 44, 330, 64)],
  },
  { x: 376, title: '纯属巧合', arrows: [] },
];
---

<figure class="law-figure">
  <div class="law-figure-scroll">
    <svg
      viewBox="0 0 500 94"
      role="img"
      aria-label="同一组上升数据的四种解释：X 导致 Y、Y 导致 X、Z 同时导致两者、或者纯属巧合。"
    >
      {panels.map((panel) => (
        <g>
          <text x={panel.x + 58} y="16" class="viz-panel-title" text-anchor="middle">{panel.title}</text>

          {panel.arrows.map((link) => (
            <>
              <path d={link.shaft} class="viz-link" />
              <path d={link.tip} class="viz-tip" />
            </>
          ))}

          <rect x={panel.x + 8} y="66" width="36" height="20" rx="6" class="viz-node" />
          <text x={panel.x + 26} y="80" class="viz-node-label" text-anchor="middle">X</text>

          <rect x={panel.x + 72} y="66" width="36" height="20" rx="6" class="viz-node" />
          <text x={panel.x + 90} y="80" class="viz-node-label" text-anchor="middle">Y</text>
        </g>
      ))}

      <rect x="288" y="24" width="34" height="20" rx="6" class="viz-node" />
      <text x="305" y="38" class="viz-node-label" text-anchor="middle">Z</text>

      <text x="434" y="82" class="viz-question" text-anchor="middle">?</text>
    </svg>
  </div>
  <figcaption>
    数据只能告诉你两条线一起动，告诉不了你谁推的谁。想往前一步，得去找那个没画在图上的 Z。
  </figcaption>
</figure>
