---
import {
  AlignLeft,
  Anchor,
  AudioLines,
  Ban,
  Bike,
  Bird,
  BookOpen,
  Brain,
  Bug,
  CalendarClock,
  ChartScatter,
  Crosshair,
  Download,
  Drama,
  Eraser,
  Eye,
  EyeOff,
  Fence,
  FileText,
  Filter,
  Fish,
  Flame,
  Gauge,
  Ghost,
  Hand,
  HandHeart,
  HeartHandshake,
  Layers,
  Lightbulb,
  Megaphone,
  MessageCircleQuestion,
  MessageSquareText,
  Minimize2,
  Mountain,
  PencilLine,
  Quote,
  Repeat,
  ReplyAll,
  Route,
  Rows3,
  Scale,
  ScanFace,
  Scissors,
  Search,
  Shield,
  ShieldCheck,
  Siren,
  TrendingDown,
  Users,
  VenetianMask,
} from 'lucide-astro';

interface Props {
  name: string;
  size?: number;
  strokeWidth?: number;
}

const { name, size = 19, strokeWidth = 1.6 } = Astro.props;

const icons = {
  AlignLeft,
  Bike,
  Bird,
  BookOpen,
  Brain,
  Bug,
  Drama,
  Eraser,
  Eye,
  FileText,
  Ghost,
  Hand,
  HeartHandshake,
  Lightbulb,
  Megaphone,
  MessageCircleQuestion,
  Minimize2,
  Mountain,
  PencilLine,
  Quote,
  Repeat,
  Route,
  Scale,
  Scissors,
  Search,
  ShieldCheck,
  Siren,
  TrendingDown,
  Users,
  VenetianMask,
  Anchor,
  AudioLines,
  Ban,
  CalendarClock,
  ChartScatter,
  Crosshair,
  Download,
  EyeOff,
  Fence,
  Filter,
  Fish,
  Flame,
  Gauge,
  HandHeart,
  Layers,
  MessageSquareText,
  ReplyAll,
  Rows3,
  ScanFace,
  Shield,
} as const;

const Icon = icons[name as keyof typeof icons] ?? Hand;
---

<Icon size={size} stroke-width={strokeWidth} aria-hidden="true" />
