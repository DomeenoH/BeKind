---
import { characters } from '../data/characters';
import LawGlyph from './LawGlyph.astro';
import { getLawIconName } from '../data/law-icons';
import { categories } from '../data/law-types';
import type { Law } from '../data/law-types';

interface Props {
  law: Law;
  position?: number;
}

const { law, position } = Astro.props;
const iconName = getLawIconName(law.slug);
const category = categories.find((item) => item.id === law.category);

const sceneSearch = [...(law.bad?.lines ?? []), ...(law.good?.lines ?? [])]
  .map((line) => `${line.character ? characters[line.character].name : line.name ?? ''} ${line.text}`)
  .join(' ');

// 只把 hero 导语并进索引（短、且常含读者会搜的关键词）。
// 解释段整段进索引会让首页体积翻三倍，不划算。
const stripHtml = (html?: string) =>
  (html ?? '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const proseSearch = stripHtml(law.hero.leadHtml);

const searchText =
  `${law.title} ${law.englishTitle} ${law.summary} ${category?.title ?? ''} ${category?.description ?? ''} ${sceneSearch} ${proseSearch}`
    .toLocaleLowerCase('zh-CN');
---

<a
  href={`/${law.slug}/`}
  class="law-card"
  data-law-card
  data-search={searchText}
>
  <h3 class="card-title">{law.title}</h3>
  <p class="card-summary">{law.summary}</p>
  <div class="card-foot">
    <span class="card-meta">
      <span class="card-index" aria-hidden="true">{String(position ?? law.order).padStart(2, '0')}</span>
      <span class="card-dot" aria-hidden="true">·</span>
      <span class="card-en">{law.englishTitle}</span>
    </span>
    <span class="card-icon" aria-hidden="true">
      <LawGlyph name={iconName} size={14} />
    </span>
  </div>
</a>
