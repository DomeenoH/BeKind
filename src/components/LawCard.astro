---
import LawGlyph from './LawGlyph.astro';
import { getLawIconName } from '../data/law-icons';
import { lawSituationsOf } from '../data/law-situations';
import type { Law } from '../data/law-types';

interface Props {
  law: Law;
  position?: number;
}

const { law, position } = Astro.props;
const iconName = getLawIconName(law.slug);
const situations = lawSituationsOf(law.slug);
---

<a
  href={`/${law.slug}/`}
  class="law-card"
  data-law-card
  data-slug={law.slug}
  data-order={law.order}
  data-situations={situations.length ? situations.join(' ') : undefined}
>
  <h3 class="card-title">{law.title}</h3>
  <p class="card-summary">{law.summary}</p>
  <div class="card-foot">
    <span class="card-meta">
      <span class="card-index" aria-hidden="true">{String(position ?? law.order).padStart(2, '0')}</span>
      <span class="card-dot" aria-hidden="true">·</span>
      <span class="card-en">{law.englishTitle}</span>
    </span>
    <span class="card-icon" aria-hidden="true">
      <LawGlyph name={iconName} size={14} />
    </span>
  </div>
</a>
