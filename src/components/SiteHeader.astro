---
import { Shuffle } from 'lucide-astro';
import { orderedLaws } from '../data/laws';
import { categories } from '../data/law-types';

const slugs = orderedLaws.map((law) => law.slug);
---

<header class="site-header">
  <div class="site-header-inner">
    <a class="brand" href="/">
      <svg class="brand-logo" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M6 16C6 10 9 6 16 6C20 6 22 8 22 12" stroke="#2c6a4d" stroke-width="2" stroke-linecap="round"/>
        <path d="M26 16C26 22 23 26 16 26C12 26 10 24 10 20" stroke="#17171b" stroke-width="2" stroke-linecap="round"/>
      </svg>
      <strong>BeKind</strong>
      <span>互联网沟通指北</span>
    </a>

    <nav class="site-nav" aria-label="主题">
      {categories.map((category) => (
        <a href={`/#${category.id}`}>{category.title}</a>
      ))}
    </nav>

    <button class="random-button" type="button" data-random-law data-slugs={JSON.stringify(slugs)}>
      <Shuffle size={14} stroke-width={1.75} aria-hidden="true" />
      <span>随机一条</span>
    </button>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-random-law]');

  button?.addEventListener('click', () => {
    const slugs: string[] = JSON.parse(button.dataset.slugs ?? '[]');
    if (!slugs.length) return;

    const current = window.location.pathname.replace(/\//g, '');
    const pool = slugs.filter((slug) => slug !== current);
    const target = pool[Math.floor(Math.random() * pool.length)] ?? slugs[0];
    window.location.href = `/${target}/`;
  });
</script>
